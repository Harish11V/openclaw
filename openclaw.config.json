{
  "brain": {
    "provider": "openai",
    "model": "gpt-5.6-sol",
    "api_key": "${OPENAI_API_KEY}"
  },
  "models": {
    "providers": {
      "openai": {
        "apiKey": "${OPENAI_API_KEY}",
        "baseUrl": "https://agentrouter.org/v1"
      }
    }
  },
  "channels": {
    "telegram": {
      "botToken": "${TELEGRAM_BOT_TOKEN}"
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8080,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  }
}
